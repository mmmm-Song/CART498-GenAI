prompt = (
    "surrealist found-image collage, symbolic juxtaposition, child's face and child head "
    "collaged onto a frail elderly body, standing in a Victorian parlor, mismatched scale, "
    "uncanny innocence and mortality, visible cut-paper join, antique magazine fragments, "
    "nineteenth-century engraving, monochrome ink, aged cream paper, cross-hatching, "
    "dream logic, dark humor"
)



negative_prompt = (
     "blurry, lowres, watermark, text, deformed faces, extra limbs, "
    "bad anatomy, extra fingers, cartoon, oversaturated, modern"
)

image = pipe(
    prompt=prompt,
    negative_prompt=negative_prompt,
    generator=torch.Generator(device).manual_seed(830), # change the seed!
    num_inference_steps=1, guidance_scale=0.0,
    height=512,
    width=512,
).images[0]

image
